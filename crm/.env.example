# Required for production. Use real company emails and long unique passwords.
PROMETEY_ADMIN_EMAIL=director@example.ru
PROMETEY_ADMIN_PASSWORD=CHANGE-ME-AT-LEAST-12-CHARS
PROMETEY_MANAGER_EMAIL=manager@example.ru
PROMETEY_MANAGER_PASSWORD=CHANGE-ME-AT-LEAST-12-CHARS

# Sessions
SESSION_TTL_HOURS=24
# Set true only when the browser reaches Prometey over HTTPS. Behind a normal HTTPS reverse proxy, "auto" is sufficient.
COOKIE_SECURE=auto

# Optional map
YANDEX_MAPS_API_KEY=

# Optional integrations
PROMETEY_SOURCE_ID=
BITRIX24_WEBHOOK=
ONEC_EXCHANGE_URL=
ONEC_TOKEN=

# Optional telephony gateway secrets, JSON map of provider -> shared secret.
# Example: {"mango":"long-secret","beeline":"another-long-secret"}
TELEPHONY_GATEWAYS={}

# Behind nginx/caddy on the same server: trust its X-Forwarded-For / X-Forwarded-Proto.
# Leave empty when the CRM is reached directly (otherwise clients could fake their IP).
TRUST_PROXY=
# Request limits (per signed-in user / per anonymous address / per telephony gateway address), per minute
API_RATE_LIMIT_PER_MIN=600
ANON_RATE_LIMIT_PER_MIN=300
WEBHOOK_RATE_LIMIT_PER_MIN=600
