{
  "name": "prometey-crm",
  "version": "1.7.0",
  "private": true,
  "description": "ПРОМЕТЕЙ CRM 1.0 — операционная CRM для аренды и субаренды спецтехники",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node tests/smoke-test.js",
    "build:demo": "node scripts/build-demo.js",
    "test:browser": "node tests/browser-smoke-cdp.js",
    "db:init": "node --disable-warning=ExperimentalWarning scripts/database.js init",
    "db:status": "node --disable-warning=ExperimentalWarning scripts/database.js status",
    "db:backup": "node --disable-warning=ExperimentalWarning scripts/database.js backup",
    "test:database": "node tests/database-test.js",
    "test:workspaces": "node tests/workspaces-test.js",
    "test:chat-contacts": "node tests/chat-contacts-test.js",
    "test:calls": "node tests/calls-test.js",
    "test:telephony": "node tests/telephony-test.js",
    "test:security": "node tests/security-test.js",
    "test:attacks": "node tests/attack-test.js",
    "test:xss": "node tests/xss-browser-test.js",
    "test:admin": "node tests/admin-feed-test.js",
    "test:accounting": "node tests/accounting-test.js",
    "test:upd": "node tests/upd-sample-test.js",
    "test:office": "node tests/office-browser-test.js",
    "credentials": "node scripts/set-credentials.js",
    "test:documents": "node tests/documents-test.js",
    "test:release": "node tests/release-test.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/full-backup.js",
    "test:integrations": "node tests/integrations-test.js",
    "test:all": "node tests/release-test.js",
    "test:browser:playwright": "node tests/browser-test.js",
    "test:performance": "node tests/performance-test.js",
    "test:ux": "node tests/ux-browser-test.js",
    "test:leads": "node tests/leads-test.js",
    "test:intro": "node tests/intro-test.js",
    "test:files": "node tests/files-test.js",
    "test:license": "node tests/license-test.js",
    "test:avito": "node tests/avito-test.js",
    "test:privacy": "node tests/privacy-test.js",
    "test:full": "node --disable-warning=ExperimentalWarning scripts/run-all-tests.js",
    "test:backend": "node --disable-warning=ExperimentalWarning scripts/run-all-tests.js --no-browser"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
